@{
    ViewData["Title"] = "Home Page";
}
<form action = '@Url.Action("GuardarDatos", "Home")' method = "POST">
<header>
    <h1>FORMULARIO DE PETICIÓN DE PRÉSTAMO</h1>
</header>
<div>
<label>
<h1>DATOS PERSONALES</h1>
    <input type="text" name = "nombre">
    <input type="number" name = "edad">
    <input type="number" name = "DNI">
</label>

<h1>SITUACIÓN LABORAL</h1>
  <input type="radio" name = "trabaja" value="Sí">Sí
  <input type="radio" name = "trabaja" value="No">No
  <select name = "TipoEmpleo">
    <option value = "1">Relación de dependencia</option>
    <option value = "2">Monotributista</option>
    <option value = "3">Autónomo</option>
    <option value = "4">Desempleado</option>
    </select>
    
<h1>INFORMACIÓN ECONÓMICA</h1>
    <input type="number" name = "ingreso mensual">
    <input type="radio" name = "deudas" value= "Sí">Sí
    <input type="radio" name = "deudas" value= "No">No
    <input type= "checkbox" name = "deudi">Tarjeta de Crédito
    <input type= "checkbox" name = "deudi">Préstamo Bancario
    <input type= "checkbox" name = "deudi">Préstamo informal

<h1>CONDICIONES DEL PRÉSTAMO</h1>
    <input type="number" name = "Monto Solicitado">
    <select name = "Plazo de devolución">
        <option value = "1">6 meses</option>
        <option value = "2">12 meses</option>
        <option value = "3">24 meses</option>
    </select>
 
 <h1>CONFIRMACIÓN</h1>
    <input type= "checkbox" name = "Acepta términos y condiciones">Acepta términos y condiciones
    <button> enviar </button>
</form>
</div>
