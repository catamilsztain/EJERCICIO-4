@{
    ViewData["Title"] = "Home Page";
}
<form action = '@Url.Action("GuardarDatos", "Home")' method = "POST">
<header>
    <h1>FORMULARIO DE PETICIÓN DE PRÉSTAMO</h1>
</header>
<div>
<label>
<h1>DATOS PERSONALES</h1>
    <h3>Nombre:</h3><input type="text" name = "nombre">
    <h3>Edad:</h3><input type="number" name = "edad">
    <h3>DNI:</h3><input type="number" name = "DNI">
</label>

<h1>SITUACIÓN LABORAL</h1>
  <h3>Trabaja?</h3><input type="radio" name = "trabaja" value="Sí">Sí
  <input type="radio" name = "trabaja" value="No">No
  <h3>Tipo de Empleo:</h3><select name = "TipoEmpleo">
    <option value = "1">Relación de dependencia</option>
    <option value = "2">Monotributista</option>
    <option value = "3">Autónomo</option>
    <option value = "4">Desempleado</option>
    </select>
    
<h1>INFORMACIÓN ECONÓMICA</h1>
    <h3>Ingreso mensual:</h3><input type="number" name = "ingresos">
    <h3>Tiene deudas?</h3><input type="radio" name = "deudas" value= "Sí">Sí
    <input type="radio" name = "deudas" value= "No">No
    <h3>En caso de responder sí, indique de que tipo:</h3><input type= "checkbox" name = "deudi">Tarjeta de Crédito
    <input type= "checkbox" name = "deudi">Préstamo Bancario
    <input type= "checkbox" name = "deudi">Préstamo informal

<h1>CONDICIONES DEL PRÉSTAMO</h1>
    <h3>Monto que solicita:</h3><input type="number" name = "monto">
    <h3>Plazo de devolución:</h3><select name = "plazo">
        <option value = "1">6 meses</option>
        <option value = "2">12 meses</option>
        <option value = "3">24 meses</option>
    </select>
 
 <h1>CONFIRMACIÓN</h1>
    <input type= "checkbox" name = "terminosyco">Acepta términos y condiciones
    <button> enviar </button>
</form>
</div>
